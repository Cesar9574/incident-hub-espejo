# Copiar a .env (NO subir .env al repo)
PORT=3000
# Si DATABASE_URL esta vacia el API usa memoria (solo desarrollo/pruebas)
DATABASE_URL=postgresql://incident_user:CAMBIAR@localhost:5432/incident_hub
# Origenes permitidos por CORS (separados por coma). Obligatorio definirlo en QA/PROD
CORS_ORIGIN=http://localhost:5173
